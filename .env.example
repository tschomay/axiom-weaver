# Vercel Blob — the durable store for Story Package snapshots, Working Drafts, and
# Compiled editions (docs/research/vercel-runtime.md §3.2, ADR 0015 §4).
# Unset locally, the app falls back to the filesystem-backed store rooted at BLOB_LOCAL_ROOT.
BLOB_READ_WRITE_TOKEN=

# Root directory for the local filesystem blob store. Defaults to ./.data
BLOB_LOCAL_ROOT=.data

# The writer call (ADR 0012). Unset, `npm run compile-scene` replays a recorded stand-in from
# fixtures/recorded/ instead of calling the model, and says so on every run.
GEMINI_API_KEY=

# Overrides the writer model (default: gemini-3.7-flash). Set to gemini-3.5-flash-lite to trade
# prose quality for request headroom on a rate-limited key — see the Gemini API key section of
# AGENTS.md. The run report records which model actually wrote each scene either way.
AXIOM_WRITER_MODEL=
